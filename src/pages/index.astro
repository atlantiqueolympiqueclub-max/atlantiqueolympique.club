---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WaveDivider from '../components/WaveDivider.astro';
import SwimDivider from '../components/SwimDivider.astro';
import StatsBand from '../components/StatsBand.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import AthleteGrid from '../components/AthleteGrid.astro';
import EventList from '../components/EventList.astro';
import FeaturedNews from '../components/FeaturedNews.astro';
import ContactBar from '../components/ContactBar.astro';
import MapEmbed from '../components/MapEmbed.astro';
import SmartImage from '../components/SmartImage.astro';
import DeepWater from '../components/DeepWater.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { Content as AboutContent, frontmatter as home } from '../data/home.md';
import { partitionEvents } from '../lib/events';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();
const isVisible = (entry: { data: { hidden?: boolean; draft?: boolean } }) =>
  !entry.data.hidden && !entry.data.draft;

const team = (await getCollection('team')).filter(isVisible).sort(byOrder);
const athletes = (await getCollection('athletes')).filter(isVisible).sort(byOrder);
const partners = (await getCollection('partners')).filter(isVisible).sort(byOrder);

const upcoming = partitionEvents((await getCollection('events')).filter(isVisible)).upcoming.slice(0, 3);

const posts = (await getCollection('blog')).filter(isVisible).sort(byDateDesc);
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const news = featured.length > 0 ? featured : posts.slice(0, 3);

// Per-network tile treatment for the "Réseaux sociaux" band. Each brand keeps
// its own identity; unknown networks fall back to the club azure.
const socialBrand: Record<string, string> = {
  instagram: 'bg-[linear-gradient(45deg,#f9ce34,#ee2a7b,#6228d7)]',
  tiktok: 'bg-[#010101] ring-1 ring-white/15',
  facebook: 'bg-[#1877f2]',
  youtube: 'bg-[#ff0000]',
};

// Decorative ghost-text ribbon under the hero
const disciplines = home.disciplines ?? ['Nage libre', 'Papillon', 'Dos', 'Brasse', '4 nages', 'Eau libre', 'Sauvetage'];
---

<BaseLayout footerWave="bg-slate-50">
  <Hero
    title={home.heroTitle}
    accent={home.heroAccent}
    subtitle={home.heroSubtitle}
    badge={home.heroBadge}
    ctaLabel={home.heroCtaLabel}
    ctaHref={home.heroCtaHref}
  />

  <!-- ============ DISCIPLINES — drifting ghost type ============ -->
  <div class="overflow-clip bg-white pb-1 pt-7 sm:pt-9" aria-hidden="true">
    <div class="marquee" style="--marquee-speed:52s">
      {[0, 1].map(() => (
        <ul>
          {disciplines.map((d) => (
            <li class="flex items-center gap-[3.5rem]">
              <span class="whitespace-nowrap font-display text-4xl font-extrabold uppercase tracking-tight text-outline sm:text-6xl">
                {d}
              </span>
              <span class="h-2.5 w-2.5 rounded-full bg-aoc-200"></span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <!-- ================= À PROPOS ================= -->
  <section id="a-propos" class="scroll-mt-24 overflow-x-clip py-14 sm:py-20">
    <div class="container-aoc">
      <SectionHeader
        eyebrow={home.aboutEyebrow ?? 'Qui sommes-nous'}
        title={home.aboutTitle ?? 'Un club, une exigence, une passion'}
        description={home.aboutDescription}
      />
    </div>

    <div class="container-aoc mt-10">
      <div class="grid items-start gap-10 md:grid-cols-[minmax(0,1fr)_17rem] md:gap-12">
        <div class="prose-aoc max-w-prose" data-reveal>
          <AboutContent />
        </div>

        <div class="relative mx-auto mt-4 w-full max-w-[16rem] md:mt-2" data-reveal="right" style="--dr:1">
          <div class="absolute -inset-2.5 -rotate-3 rounded-3xl bg-gradient-to-tr from-aoc-200/80 to-aoc-400/30" aria-hidden="true"></div>
          <SmartImage
            src={home.aboutImage ?? '/images/about-team.svg'}
            alt={home.aboutImageAlt ?? "L'équipe de l'Atlantique Olympique Club"}
            rounded="rounded-2xl"
            class="relative aspect-square w-full border-4 border-white shadow-xl shadow-aoc-900/15"
          />
          {(home.aboutBadge ?? 'Dakar · Sénégal') && (
            <span class="animate-float absolute -bottom-4 -left-4 inline-flex items-center gap-1.5 rounded-full border border-slate-100 bg-white px-3.5 py-1.5 text-xs font-bold text-navy shadow-lg">
              <Icon name="map-pin" class="h-3.5 w-3.5 text-aoc-500" />
              {home.aboutBadge ?? 'Dakar · Sénégal'}
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- Partners -->
    {partners.length > 0 && (
      <div class="container-aoc mt-14" data-reveal>
        <p class="text-center text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
          {home.partnersLabel ?? 'Nos partenaires'}
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
          {partners.map((p) =>
            p.data.url ? (
              <a
                href={p.data.url}
                target="_blank"
                rel="noopener noreferrer"
                title={p.data.name}
                class="opacity-70 grayscale transition-all duration-300 hover:-translate-y-1 hover:opacity-100 hover:grayscale-0"
              >
                <img src={p.data.logo} alt={p.data.logoAlt ?? p.data.name} class="h-12 w-auto" loading="lazy" />
              </a>
            ) : (
              <img
                src={p.data.logo}
                alt={p.data.logoAlt ?? p.data.name}
                class="h-12 w-auto opacity-70 grayscale transition-all duration-300 hover:opacity-100 hover:grayscale-0"
                loading="lazy"
              />
            ),
          )}
        </div>
      </div>
    )}
  </section>

  <!-- ============ LE CLUB EN CHIFFRES — odometer band ============ -->
  <WaveDivider from="bg-white" to="fill-aoc-600" />
  <StatsBand />
  <WaveDivider from="bg-aoc-500" to="fill-slate-50" flip />

  <!-- ================= LE CLUB ================= -->
  <section id="le-club" class="scroll-mt-24 bg-slate-50 py-14 sm:py-20">
    <div class="container-aoc">
      <SectionHeader
        eyebrow={home.clubEyebrow ?? 'Le club'}
        title={home.clubTitle ?? "L'AOC en personnes"}
        description={home.clubDescription ?? "Encadrement diplômé, athlètes engagés : découvrez celles et ceux qui font vivre le club."}
      />
    </div>

    <!-- Encadrement -->
    <div class="container-aoc mt-10">
      <h3 class="font-display text-xs font-bold uppercase tracking-[0.14em] text-slate-400">{home.teamHeading ?? 'Encadrement'}</h3>
      <div class="mt-6">
        <TeamCarousel members={team} />
      </div>
    </div>

    <!-- Athlètes -->
    <div class="container-aoc mt-14">
      <h3 class="font-display text-xs font-bold uppercase tracking-[0.14em] text-slate-400">{home.athletesHeading ?? 'Athlètes'}</h3>
      <div class="mt-7">
        <AthleteGrid athletes={athletes} showPalmares={false} />
      </div>
    </div>
  </section>

  <WaveDivider from="bg-slate-50" to="fill-white" flip />

  <!-- ================= ACTUALITÉS ================= -->
  <section id="actualites" class="scroll-mt-24 py-14 sm:py-20">
    <div class="container-aoc">
      <SectionHeader
        eyebrow={home.newsEyebrow ?? 'Actualités'}
        title={home.newsTitle ?? 'Dernières nouvelles'}
        description={home.newsDescription ?? 'Résultats, conseils et coulisses de la vie du club.'}
      />

      {news.length > 0 && (
        <div class="mt-10">
          <FeaturedNews posts={news} />
        </div>
      )}

      <div class="mt-9" data-reveal="fade">
        <a href="/blog" class="link-arrow">
          {home.newsMoreLabel ?? "Voir plus d'articles"} <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- A little freestyler crosses the page on the way into the dark water -->
  <SwimDivider from="bg-white" to="fill-navy" />

  {site.social.length > 0 && (
    <section id="reseaux" class="grain relative isolate scroll-mt-24 overflow-clip bg-navy py-16 text-white sm:py-20">
      <div class="blob -z-10 left-[10%] top-[-5rem] h-80 w-80 bg-aoc-400/20 mix-blend-screen" aria-hidden="true"></div>
      <div class="blob -z-10 bottom-[-7rem] right-[6%] h-96 w-96 bg-aoc-300/15 mix-blend-screen" data-late aria-hidden="true"></div>
      <!-- Deep water: dim caustic light and a slow godray or two -->
      <DeepWater class="-z-10" intensity={0.5} rays color="#d6f2ff" />

      <div class="container-aoc grid gap-x-12 gap-y-9 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-center">
        <div data-reveal>
          <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-aoc-300">
            {home.socialEyebrow ?? 'Réseaux sociaux'}
          </p>
          <h2 class="mt-2 max-w-md font-display text-[clamp(1.5rem,1.1rem+1.9vw,2.3rem)] font-extrabold tracking-tight">
            {home.socialTitle ?? "Suivez l'AOC au quotidien"}
          </h2>
          <p class="mt-4 max-w-md text-aoc-50/85">
            {home.socialDescription ?? 'Entraînements, compétitions, coulisses — la vie du club en images et en vidéos.'}
          </p>
        </div>

        <ul class="grid gap-3" data-reveal="right" style="--dr:1">
          {site.social.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group glass flex items-center gap-4 rounded-2xl p-4 transition-all duration-300 hover:-translate-y-1 hover:bg-white/[0.12]"
              >
                <span
                  class:list={[
                    'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-white shadow-lg',
                    socialBrand[s.icon] ?? 'bg-aoc-500',
                  ]}
                >
                  <Icon name={s.icon} class="h-6 w-6" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-display font-bold leading-tight text-white">{s.label}</span>
                  <span class="block truncate text-sm text-aoc-200">{s.blurb ?? s.handle}</span>
                </span>
                <Icon
                  name="arrow-right"
                  class="h-4 w-4 shrink-0 text-aoc-300 transition-transform duration-300 group-hover:translate-x-1"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <WaveDivider from="bg-navy" to="fill-slate-50" flip />

  <!-- ================= AGENDA & CONTACT ================= -->
  <section id="contact" class="scroll-mt-24 bg-slate-50 py-14 sm:py-20">
    <div class="container-aoc">
      <SectionHeader
        eyebrow={home.contactEyebrow ?? 'Contact'}
        title={home.contactTitle ?? 'Venez nous rencontrer'}
        description={home.contactDescription ?? 'Prochains rendez-vous sportifs et coordonnées du club.'}
      />
    </div>

    <div class="container-aoc mt-10 grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <div>
        {upcoming.length > 0 && (
          <>
            <h3 class="mb-5 font-display text-xs font-bold uppercase tracking-[0.14em] text-slate-400">{home.upcomingHeading ?? 'Prochains événements'}</h3>
            <EventList events={upcoming} />
            <div class="mt-6" data-reveal="fade">
              <a href="/evenements" class="link-arrow">
                {home.eventsMoreLabel ?? 'Tous les événements'} <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </>
        )}
      </div>

      <div>
        <h3 class="mb-5 font-display text-xs font-bold uppercase tracking-[0.14em] text-slate-400">{home.contactHeading ?? 'Coordonnées'}</h3>
        <ContactBar layout="stack" />
        <div class="mt-6">
          <MapEmbed />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
