---
import site from '../data/site.json';
import DeepWater from './DeepWater.astro';

/**
 * "Le club en chiffres" — a luminous pool-blue band of key numbers.
 * In browsers with CSS scroll-driven animations the digits roll up like
 * an odometer as the band enters the viewport (pure CSS, `--num` counter
 * in global.css); everywhere else the static values simply render.
 * Numbers are editable in `src/data/site.json` → `stats`.
 */
interface Stat {
  value: number;
  suffix?: string;
  label: string;
}
const stats = (site.stats ?? []) as Stat[];
---

{stats.length > 0 && (
  <section
    aria-label="Le club en chiffres"
    class="grain relative isolate overflow-clip bg-gradient-to-b from-aoc-600 via-aoc-500 to-aoc-500 py-14 text-white sm:py-16"
  >
    <div class="blob -z-10 left-[14%] top-[-5rem] h-64 w-64 bg-white/15 mix-blend-screen" aria-hidden="true"></div>
    <!-- Sunlit shallows: caustic light rippling across the bright band -->
    <DeepWater class="-z-10" intensity={0.5} color="#f0feff" />

    <div class="container-aoc">
      <dl class="grid grid-cols-2 gap-x-6 gap-y-10 text-center md:grid-cols-4">
        {stats.map((s, i) => (
          <div class="flex flex-col-reverse" data-reveal style={`--dr:${i}`}>
            <dt class="mt-2.5 font-display text-[0.7rem] font-bold uppercase tracking-[0.18em] text-aoc-50/90">
              {s.label}
            </dt>
            <dd class="font-display text-[clamp(2.6rem,2rem+2.6vw,3.9rem)] font-black leading-none tracking-tight drop-shadow-[0_2px_12px_rgba(11,42,74,0.25)]">
              <span
                class="stat-count"
                aria-hidden="true"
                style={`--nt:${s.value}; --digits:${String(s.value).length}`}
              ></span><span class="stat-static">{s.value}</span>{s.suffix && (
                <span class="text-aoc-100">{s.suffix}</span>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}
