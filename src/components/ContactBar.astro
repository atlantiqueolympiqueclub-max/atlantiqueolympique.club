---
import contact from '../data/contact.json';
import site from '../data/site.json';
import Icon from './Icon.astro';

interface Props {
  layout?: 'grid' | 'stack';
}
const { layout = 'grid' } = Astro.props;
const stacked = layout === 'stack';
const tel = (n: string) => 'tel:' + n.replace(/[^+\d]/g, '');
const addr = [contact.address.street, contact.address.city, contact.address.country]
  .filter(Boolean)
  .join(', ');
const contactGrid = stacked ? '' : contact.phoneSecondary ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3';
---

<div class:list={['grid gap-3', contactGrid]}>
  <a href={tel(contact.phone)} class="card-aoc group flex items-center gap-3.5 p-4" data-reveal>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aoc-400 to-aoc-600 text-white shadow-md shadow-aoc-500/30 transition-transform duration-300 group-hover:scale-110">
      <Icon name="phone" class="h-5 w-5" />
    </span>
    <span class="min-w-0">
      <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Téléphone</span>
      <span class="block truncate font-semibold text-navy">{contact.phone}</span>
    </span>
  </a>

  {contact.phoneSecondary && (
    <a href={tel(contact.phoneSecondary)} class="card-aoc group flex items-center gap-3.5 p-4" data-reveal style="--dr:1">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aoc-400 to-aoc-600 text-white shadow-md shadow-aoc-500/30 transition-transform duration-300 group-hover:scale-110">
        <Icon name="phone" class="h-5 w-5" />
      </span>
      <span class="min-w-0">
        <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Téléphone secondaire</span>
        <span class="block truncate font-semibold text-navy">{contact.phoneSecondary}</span>
      </span>
    </a>
  )}

  <a href={`mailto:${contact.email}`} class="card-aoc group flex items-center gap-3.5 p-4" data-reveal style={contact.phoneSecondary ? '--dr:2' : '--dr:1'}>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aoc-400 to-aoc-600 text-white shadow-md shadow-aoc-500/30 transition-transform duration-300 group-hover:scale-110">
      <Icon name="mail" class="h-5 w-5" />
    </span>
    <span class="min-w-0">
      <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Email</span>
      <span class="block truncate font-semibold text-navy">{contact.email}</span>
    </span>
  </a>

  <div class="card-aoc flex items-center gap-3.5 p-4" data-reveal style={contact.phoneSecondary ? '--dr:3' : '--dr:2'}>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aoc-400 to-aoc-600 text-white shadow-md shadow-aoc-500/30">
      <Icon name="map-pin" class="h-5 w-5" />
    </span>
    <span class="min-w-0">
      <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Adresse</span>
      <span class="block font-semibold text-navy">{addr}</span>
    </span>
  </div>
</div>

<div class="mt-5 flex flex-wrap items-center gap-3" data-reveal style={contact.phoneSecondary ? '--dr:4' : '--dr:3'}>
  <span class="text-sm font-semibold text-slate-500">Suivez-nous :</span>
  <ul class="flex items-center gap-2">
    {site.social.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
          class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-navy text-white transition-all duration-300 hover:-translate-y-1 hover:bg-aoc-600 hover:shadow-lg hover:shadow-aoc-600/30"
        >
          <Icon name={s.icon} class="h-4 w-4" />
        </a>
      </li>
    ))}
  </ul>
</div>
