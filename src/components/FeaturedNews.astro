---
import SmartImage from './SmartImage.astro';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

/** "LE TOP NEWS" — one large lead story + up to two secondary cards. */
interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
const [lead, ...rest] = posts;
const secondary = rest.slice(0, 2);
const fmt = new Intl.DateTimeFormat('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
---

{lead && (
  <div class="grid gap-5 lg:grid-cols-[1.25fr_0.75fr]">
    <a
      href={`/blog/${lead.id}`}
      class="card-aoc group grid overflow-clip md:grid-cols-[0.95fr_1.05fr]"
      data-reveal
    >
      <div class="relative overflow-clip" transition:name={`cover-${lead.id}`}>
        <SmartImage
          src={lead.data.cover}
          alt={lead.data.title}
          class="aspect-[16/11] h-full w-full transition-transform duration-700 group-hover:scale-[1.05]"
          rounded="rounded-none"
          loading="eager"
        />
        <span class="absolute left-4 top-4 rounded-full bg-gradient-to-r from-aoc-500 to-aoc-600 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.14em] text-white shadow-md shadow-aoc-600/30">
          À la une
        </span>
      </div>
      <div class="flex flex-col justify-center p-5 sm:p-7">
        <time class="text-xs font-medium text-slate-400" datetime={lead.data.date.toISOString()}>
          {fmt.format(lead.data.date)}
        </time>
        <h3 class="mt-3 font-display text-2xl font-extrabold leading-tight text-navy transition-colors group-hover:text-aoc-700">
          {lead.data.title}
        </h3>
        <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">{lead.data.excerpt}</p>
        <span class="link-arrow mt-5 text-sm text-aoc-700">
          Lire l'article <Icon name="arrow-right" class="h-4 w-4" />
        </span>
      </div>
    </a>

    <div class="grid content-start gap-3">
      {secondary.map((p, i) => (
        <a
          href={`/blog/${p.id}`}
          class="card-aoc group grid grid-cols-[5.5rem_1fr] gap-4 p-3"
          data-reveal
          style={`--dr:${i + 1}`}
        >
          <span class="block overflow-clip rounded-xl" transition:name={`cover-${p.id}`}>
            <SmartImage
              src={p.data.cover}
              alt={p.data.title}
              class="aspect-square w-full transition-transform duration-700 group-hover:scale-[1.07]"
              rounded="rounded-none"
            />
          </span>
          <span class="min-w-0 self-center">
            <time class="text-xs text-slate-400" datetime={p.data.date.toISOString()}>
              {fmt.format(p.data.date)}
            </time>
            <h4 class="mt-1 line-clamp-2 text-sm font-bold leading-snug text-navy transition-colors group-hover:text-aoc-700">
              {p.data.title}
            </h4>
            <span class="link-arrow mt-1.5 text-xs">
              Lire <Icon name="arrow-right" class="h-3 w-3" />
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
)}
