---
import SmartImage from './SmartImage.astro';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  athletes: CollectionEntry<'athletes'>[];
  showPalmares?: boolean;
}
const { athletes, showPalmares = true } = Astro.props;
---

<ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
  {athletes.map((a, i) => (
    <li
      class="group flex flex-col items-center text-center"
      data-reveal
      style={`--dr:${i % 5}`}
    >
      <span class="ring-water inline-flex transition-transform duration-300 group-hover:scale-105">
        <SmartImage
          src={a.data.photo}
          alt={a.data.name}
          rounded="rounded-full"
          class="h-24 w-24 ring-[3px] ring-white sm:h-28 sm:w-28"
        />
      </span>
      <p class="mt-3 text-sm font-bold leading-tight text-navy">{a.data.name}</p>
      {a.data.discipline && (
        <p class="mt-1 rounded-full bg-aoc-50 px-2.5 py-0.5 text-xs font-semibold text-aoc-700">
          {a.data.discipline}
        </p>
      )}

      {showPalmares && a.data.palmares.length > 0 ? (
        <details class="group/palmares mt-2.5 w-full">
          <summary class="btn-shine mx-auto inline-flex w-fit cursor-pointer list-none items-center gap-1 rounded-full bg-gradient-to-r from-aoc-500 to-aoc-600 px-3.5 py-1 text-[0.7rem] font-bold uppercase tracking-wide text-white shadow-md shadow-aoc-500/30 transition-shadow hover:shadow-lg hover:shadow-aoc-500/40 [&::-webkit-details-marker]:hidden">
            Voir palmarès
            <Icon name="chevron-right" class="h-3 w-3 transition-transform duration-300 group-open/palmares:rotate-90" />
          </summary>
          <ul class="mt-2 space-y-1.5 rounded-xl border border-aoc-100 bg-aoc-50 p-3 text-left text-xs text-slate-600">
            {a.data.palmares.map((p) => (
              <li class="flex gap-1.5">
                <Icon name="check" class="mt-0.5 h-3 w-3 shrink-0 text-aoc-500" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </details>
      ) : showPalmares ? (
        <span class="mt-2.5 inline-block rounded-full bg-slate-100 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-slate-400">
          Palmarès à venir
        </span>
      ) : null}
    </li>
  ))}
</ul>
