---
/**
 * Grey image placeholder with the "photo" glyph from the mockup.
 * Used as a graceful fallback and for decorative empty tiles.
 */
interface Props {
  class?: string;
  rounded?: string;
}
const { class: className = 'aspect-video w-full', rounded = 'rounded-lg' } = Astro.props;
---

<div class:list={['ph-block flex items-center justify-center', rounded, className]} aria-hidden="true">
  <svg class="h-1/3 max-h-12 w-auto text-aoc-400/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <circle cx="8.5" cy="9.5" r="1.8" />
    <path d="m4 18 5-5 4 4 3-3 4 4" />
  </svg>
</div>
