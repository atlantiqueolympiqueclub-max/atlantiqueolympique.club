---
/**
 * Inline SVG icon set — zero external requests, themeable via `currentColor`.
 * Usage: <Icon name="phone" class="h-5 w-5" />
 */
interface Props {
  name: string;
  class?: string;
  title?: string;
}
const { name, class: className = 'h-5 w-5', title } = Astro.props;

// UI glyphs are drawn as strokes; brand glyphs as fills. All on a 24×24 box.
const strokeIcons = new Set([
  'phone', 'mail', 'map-pin', 'arrow-right', 'arrow-left', 'arrow-up', 'chevron-right',
  'chevron-down', 'menu', 'close', 'external-link', 'calendar', 'heart', 'check',
  'alert-triangle', 'clock',
]);
const isStroke = strokeIcons.has(name);

const paths: Record<string, string> = {
  // UI (stroke)
  phone:
    '<path d="M3 5a2 2 0 0 1 2-2h2.6a1 1 0 0 1 .95.68l1.2 3.5a1 1 0 0 1-.5 1.2l-1.7.9a12 12 0 0 0 5.5 5.5l.9-1.7a1 1 0 0 1 1.2-.5l3.5 1.2a1 1 0 0 1 .68.95V19a2 2 0 0 1-2 2A16 16 0 0 1 3 5Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  'map-pin':
    '<path d="M12 21s-7-5.2-7-11a7 7 0 1 1 14 0c0 5.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-left': '<path d="M19 12H5"/><path d="m11 6-6 6 6 6"/>',
  'arrow-up': '<path d="M12 19V5"/><path d="m6 11 6-6 6 6"/>',
  'chevron-right': '<path d="m9 6 6 6-6 6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7"/>',
  'alert-triangle': '<path d="M12 4 2.8 19.6h18.4L12 4Z"/><path d="M12 10v4.2"/><path d="M12 17.2h.01"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2.5"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  'external-link':
    '<path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/>',
  heart:
    '<path d="M12 20s-7-4.4-7-9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 7 3.5C19 15.6 12 20 12 20Z"/>',
  // Brand (fill)
  facebook:
    '<path d="M14 8.5V7c0-.8.2-1 1-1h1.5V3.2C16 3 15 3 14 3c-2.6 0-4 1.6-4 4.4V8.5H7.5V12H10v9h3.5v-9h2.6l.4-3.5H13.5V8.5Z"/>',
  instagram:
    '<path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5Zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5ZM17.5 6a1 1 0 1 1-1 1 1 1 0 0 1 1-1Z"/>',
  tiktok:
    '<path d="M13.5 0h2.97c.216 1.0725.81 2.4255 1.8525 3.768C19.3425 5.0835 20.6955 6 22.5 6v3c-2.6295 0-4.605-1.221-6-2.7435V16.5a7.5 7.5 0 1 1-7.5-7.5v3a4.5 4.5 0 1 0 4.5 4.5V0Z"/>',
  youtube:
    '<path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.7-1.7C19.3 5.2 12 5.2 12 5.2s-7.3 0-8.9.4A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.7 1.7c1.6.4 8.9.4 8.9.4s7.3 0 8.9-.4a2.5 2.5 0 0 0 1.7-1.7C23 15.2 23 12 23 12ZM9.8 15.3V8.7l5.7 3.3-5.7 3.3Z"/>',
  x: '<path d="M3 3h4.8l4 5.7L16.5 3H21l-6.7 8.3L21.5 21h-4.8l-4.4-6.2L7.2 21H3l7-8.6L3 3Z"/>',
  linkedin:
    '<path d="M4.5 3.5A2 2 0 1 1 4.5 7.5a2 2 0 0 1 0-4ZM3 9h3v12H3V9Zm5 0h2.9v1.7h.05A3.2 3.2 0 0 1 14 9c3 0 3.6 2 3.6 4.6V21h-3v-5.8c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H8V9Z"/>',
};

const inner = (title ? `<title>${title}</title>` : '') + (paths[name] ?? '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  viewBox="0 0 24 24"
  fill={isStroke ? 'none' : 'currentColor'}
  stroke={isStroke ? 'currentColor' : undefined}
  stroke-width={isStroke ? 1.8 : undefined}
  stroke-linecap={isStroke ? 'round' : undefined}
  stroke-linejoin={isStroke ? 'round' : undefined}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  set:html={inner}
/>
