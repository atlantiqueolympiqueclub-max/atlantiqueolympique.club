---
import site from '../data/site.json';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
---

<header
  transition:persist
  class="header-elevate sticky top-0 z-50 border-b border-slate-200/70 bg-white/85 backdrop-blur-md"
>
  <nav class="container-aoc flex items-center justify-between gap-4 py-2.5" aria-label="Navigation principale">
    <a href="/" class="group shrink-0" aria-label="Accueil — Atlantique Olympique Club">
      <Logo
        tagline={false}
        class="transition-transform duration-300 group-hover:scale-[1.03]"
      />
    </a>

    <!-- Pure-CSS mobile toggle -->
    <input type="checkbox" id="nav-toggle" class="peer hidden" aria-hidden="true" />

    <!-- Nav links -->
    <div
      class="nav-panel absolute inset-x-0 top-full hidden flex-col gap-1 border-b border-slate-200/70 bg-white p-4 shadow-xl peer-checked:flex lg:static lg:flex lg:flex-row lg:items-center lg:gap-0.5 lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none"
    >
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="nav-link relative rounded-lg px-3 py-2 text-sm font-medium text-navy/75 transition-colors hover:bg-aoc-50/70 hover:text-aoc-700 lg:py-1.5 lg:hover:bg-transparent"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Hamburger (mobile only) — icon swaps to a cross while open -->
    <label
      for="nav-toggle"
      class="inline-flex cursor-pointer items-center justify-center rounded-lg p-2 text-navy transition-colors hover:bg-aoc-50 lg:hidden"
      aria-label="Ouvrir ou fermer le menu"
    >
      <span class="icon-menu"><Icon name="menu" class="h-6 w-6" /></span>
      <span class="icon-close hidden"><Icon name="close" class="h-6 w-6" /></span>
    </label>
  </nav>

  <!-- Reading progress (scroll-driven, decorative) -->
  <div class="scroll-progress" aria-hidden="true"></div>
</header>

<style>
  /* Hamburger ↔ cross swap while the mobile menu is open */
  #nav-toggle:checked ~ label .icon-menu {
    display: none;
  }
  #nav-toggle:checked ~ label .icon-close {
    display: inline-flex;
  }

  /* Animated gradient underline under each nav link */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-aoc-400), var(--color-aoc-600));
    transform: scaleX(0);
    transform-origin: left;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-link::after {
      transition: transform 0.3s ease;
    }
  }

  /* Mobile panel slides down softly each time it opens */
  @media (max-width: 63.9375rem) and (prefers-reduced-motion: no-preference) {
    .nav-panel {
      animation: rise-in 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
</style>
